{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "dart",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "release: Dextop ${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "revert",
      "section": "Removed"
    },
    {
      "type": "refactor",
      "section": "Removed"
    },
    {
      "type": "perf",
      "section": "Enhanced"
    },
    {
      "type": "build",
      "section": "Upgraded"
    },
    {
      "type": "deps",
      "section": "Upgraded"
    },
    {
      "type": "chore",
      "section": "Upgraded"
    },
    {
      "type": "ci",
      "section": "Upgraded"
    }
  ],
  "packages": {
    ".": {
      "package-name": "dextop",
      "changelog-path": "CHANGELOG.md",
      "prerelease": true,
      "versioning": "prerelease",
      "prerelease-type": "beta"
    }
  }
}
